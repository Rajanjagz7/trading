{
  "version": 2,
  "public": "public",
  "buildCommand": "echo 'No build needed'",
  "builds": [
    {
      "src": "api/tv.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/tv(.*)",
      "dest": "api/tv.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
