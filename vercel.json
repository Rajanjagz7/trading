{
  "builds": [
    {
      "src": "api/tv.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/tv(.*)",
      "dest": "api/tv.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "public/$1"
    }
  ],
  "crons": [
    {
      "path": "/api/cleanup",
      "schedule": "30 18 * * 6"
    },
    {
      "path": "/api/cron",
      "schedule": "46 3 * * 1-5"
    },
    {
      "path": "/api/cron",
      "schedule": "51 3 * * 1-5"
    }
  ]
}
