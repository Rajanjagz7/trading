{
  "version": 2,
  "buildCommand": "echo Build",
  "outputDirectory": "public",
  "builds": [
    {
      "src": "api/tv.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/tv.*",
      "dest": "api/tv.js"
    },
    {
      "src": "/api/.*",
      "dest": "api/index.py"
    }
  ]
}
