{
  "buildCommand": "echo 'Vercel Build' && date",
  "outputDirectory": ".",
  "version": 2,
  "builds": [
    {
      "src": "api/tv.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/tv.*",
      "dest": "api/tv.js"
    },
    {
      "src": "/api/.*",
      "dest": "api/index.py"
    }
  ]
}
